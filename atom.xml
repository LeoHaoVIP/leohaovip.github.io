&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;CentOS 7&lt;/td&gt;
&lt;td&gt;5.4.275&lt;/td&gt;
&lt;td&gt;&amp;gt; 100G&lt;/td&gt;
&lt;td&gt;&amp;gt; 4G&lt;/td&gt;
&lt;td&gt;&amp;gt; 8 Core&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;</summary>
    
    
    
    
